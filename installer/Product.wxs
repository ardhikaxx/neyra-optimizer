<?xml version="1.0" encoding="UTF-8"?>
<!--
  Neyra Optimizer MSI definition (WiX Toolset v5).

  Design decisions:
  - Per-machine install into Program Files64; the app itself runs asInvoker and elevates
    per-operation through UAC only when the user applies changes that require admin.
  - Stable UpgradeCode; ProductCode regenerated each build (*) for clean major upgrades.
  - No embedded scripts. Uninstall removes program files only; snapshots/history under
    ProgramData\NeyraOptimizer and settings under %APPDATA%\NeyraOptimizer are intentionally
    PRESERVED so rollback data survives removal (see docs/SECURITY.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?define PublishRoot = "$(var.SolutionDir)artifacts\publish" ?>
  <?define AssetIcon = "$(var.SolutionDir)src\NeyraOptimizer.App\Assets\neyra.ico" ?>

  <Package
      Name="Neyra Optimizer"
      Manufacturer="Neyra Software"
      Version="$(var.ProductVersion)"
      Scope="perMachine"
      UpgradeStrategy="majorUpgrade"
      Compressed="true"
      ProductCode="*"
      UpgradeCode="7A1C2E9D-4B6F-4E52-9C3A-58D0E1F2A777">

    <SummaryInformation Description="Neyra Optimizer – Performance Tuning Tool for Windows 10 &amp; 11" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="NeyraIco.exe" SourceFile="$(var.AssetIcon)" />
    <Property Id="ARPPRODUCTICON" Value="NeyraIco.exe" />

    <!-- Start Menu shortcut (non-advertised so it survives simple installs) -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="NeyraShortcutDir" Name="Neyra Optimizer">
        <Component Id="ShortcutComponent" Guid="9F3B7C41-2E85-4D6A-B14C-A90F53D81234">
          <Shortcut Id="StartMenuShortcut"
                    Name="Neyra Optimizer"
                    Description="Performance Tuning Tool for Windows 10 &amp; 11"
                    Target="[INSTALLFOLDER]NeyraOptimizer.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="NeyraIco.exe" />
          <RemoveFolder Id="RemoveNeyraShortcutDir" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\NeyraOptimizer\Installer"
                         Name="ShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Neyra Optimizer">
        <Component Id="MainExecutable" Guid="C81E7A65-3F2B-4B9D-8E44-F0A9C1D2B333">
          <File Id="NeyraExe" Source="$(var.PublishRoot)\NeyraOptimizer.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Payload components are auto-generated by scripts/build-installer.ps1
         into installer\obj\PublishPayload.g.wxs (one component per published file,
         including localized satellites under id\). -->
    <Feature Id="Main" Title="Neyra Optimizer" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentGroupRef Id="PublishPayload" />
      <ComponentRef Id="ShortcutComponent" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
