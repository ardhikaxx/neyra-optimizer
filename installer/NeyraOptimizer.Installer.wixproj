<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>NeyraOptimizer-$(ProductVersion)-x64</OutputName>
    <Platform>x64</Platform>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" PrivateAssets="all" />
    <!-- Payload fragment is generated by scripts/build-installer.ps1 from artifacts\publish -->
    <Compile Include="obj\PublishPayload.g.wxs" Link="PublishPayload.g.wxs" Condition="Exists('obj\PublishPayload.g.wxs')" />
  </ItemGroup>

</Project>
