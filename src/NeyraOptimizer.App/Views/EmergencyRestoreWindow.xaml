<Window x:Class="NeyraOptimizer.App.Views.EmergencyRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization"
        Title="{loc:Loc Emergency.Title}" Width="640" Height="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Window.Background}"
        Icon="/Assets/neyra.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc Emergency.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{loc:Loc Emergency.Body}" TextWrapping="Wrap" FontSize="12.5"/>
        </StackPanel>

        <ListBox x:Name="ListPanel" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource RowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CreatedUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                           Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11.5"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{loc:Loc Common.Restore}"
                                    Click="Restore_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="CloseBtn" Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,0,0"
                Style="{StaticResource SecondaryButton}" Content="{loc:Loc Common.Close}" Click="Close_Click"/>
    </Grid>
</Window>
