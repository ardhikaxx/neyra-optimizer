<Window x:Class="NeyraOptimizer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization"
        xmlns:vm="clr-namespace:NeyraOptimizer.App.ViewModels"
        Title="{loc:Loc App.Title}"
        Width="1180" Height="760" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        Icon="/Assets/neyra.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ────────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar.Background}"
                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,18,16,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.Accent}">
                            <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="19"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,1,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc App.Title}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="{loc:Loc App.Subtitle}" FontSize="10.3"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedItem}" Margin="0,2,0,0"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="7"
                                                Margin="9,1" Padding="12,8">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ListItem.Hover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.9"/>
                                <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="20,8,16,14">
                    <Separator Background="{DynamicResource Brush.Divider}" Margin="0,0,0,9"/>
                    <TextBlock Text="{Binding Session.Compatibility.OsSummary}" FontSize="10.5"
                               Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="10.5"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Content ────────────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="30,14,30,0">
                <Border Background="{DynamicResource Brush.Badge.Optional.Bg}"
                        CornerRadius="8" Padding="14,9" Margin="0,4,0,10"
                        Visibility="{Binding ShowReadOnlyBanner, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding BannerText}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Badge.Optional.Fg}"/>
                </Border>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="30,10,30,22"/>

            <Border Grid.RowSpan="3" Background="#90000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Card.Border}"
                        BorderThickness="1" CornerRadius="12" Padding="30,22"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel MinWidth="280">
                        <ProgressBar IsIndeterminate="True" Width="260"/>
                        <TextBlock Text="{Binding BusyText}" Margin="0,14,0,0" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
