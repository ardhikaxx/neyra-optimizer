<UserControl x:Class="NeyraOptimizer.App.Views.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization">
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Startup.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleCommand}"
                        Content="{loc:Loc Common.Disable}" Margin="8,0,0,0" MinWidth="100"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleCommand}"
                        Content="{loc:Loc Common.Enable}" Margin="8,0,0,0" MinWidth="100"/>
                <TextBox Width="260" VerticalAlignment="Center" Style="{StaticResource NeyraTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}"
                 Style="{StaticResource NeyraListBox}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource RowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Source}" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Publisher}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Impact}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
