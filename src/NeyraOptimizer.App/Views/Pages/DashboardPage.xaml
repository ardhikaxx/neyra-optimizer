<UserControl x:Class="NeyraOptimizer.App.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Dashboard.Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding LastAnalysisText}" Style="{StaticResource MutedText}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Command="{Binding AnalyzeCommand}"
                        Content="{loc:Loc Common.AnalyzeMyPC}" IsEnabled="{Binding CanModify, Mode=OneWay}"/>
            </Grid>

            <TextBlock Text="{Binding AnalyzeStatus}" Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,10" TextWrapping="Wrap"/>

            <!-- Score + live metrics -->
            <UniformGrid Columns="4" Rows="2" Margin="0,0,0,14">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dash.PerformanceScore}" Style="{StaticResource MutedText}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="{Binding Score}" FontSize="34" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}"/>
                            <TextBlock Text="/ 100" FontSize="13" VerticalAlignment="Bottom" Margin="4,0,8,7"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                        <Border Style="{StaticResource BadgeBorder}"
                                Background="{DynamicResource Brush.Badge.Recommended.Bg}">
                            <TextBlock Text="{Binding ScoreBand}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Badge.Recommended.Fg}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dash.RamUsage}" Style="{StaticResource MutedText}"/>
                        <ProgressBar Value="{Binding RamUsedPercent, Mode=OneWay}" Maximum="100" Margin="0,12,0,8"/>
                        <TextBlock Text="{Binding RamText}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RamUsedPercent, StringFormat={}{0}%}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dash.CpuUsage}" Style="{StaticResource MutedText}"/>
                        <ProgressBar Value="{Binding CpuPercent, FallbackValue=0, Mode=OneWay}" Maximum="100" Margin="0,12,0,8"/>
                        <TextBlock FontSize="17" FontWeight="SemiBold">
                            <Run Text="{Binding CpuPercent, FallbackValue=—, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                        <TextBlock Text="{loc:Loc Dash.CommitCharge}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dash.DiskActivity}" Style="{StaticResource MutedText}"/>
                        <ProgressBar Value="{Binding DiskPercent, FallbackValue=0, Mode=OneWay}" Maximum="100" Margin="0,12,0,8"/>
                        <TextBlock FontSize="17" FontWeight="SemiBold">
                            <Run Text="{Binding DiskPercent, FallbackValue=—, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                        <TextBlock Text="{loc:Loc Dash.GpuUsage}" Style="{StaticResource MutedText}"/>
                        <TextBlock>
                            <Run Text="{Binding GpuPercent, FallbackValue=—, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dash.Processes}" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding ProcessCount}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dash.StartupEntries}" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding StartupCount}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dash.FreeStorage}" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding FreeStorageText}" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dash.DeviceClass}" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding DeviceClassText}" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Session.Compatibility.OsSummary}" Style="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="{DynamicResource Brush.Input.Background}" BorderBrush="{DynamicResource Brush.Card.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="12,9">
                <TextBlock Text="{loc:Loc Dash.TempUnavailable}" FontSize="11.5"
                           Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
