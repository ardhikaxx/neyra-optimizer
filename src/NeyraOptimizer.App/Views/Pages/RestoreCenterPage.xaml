<UserControl x:Class="NeyraOptimizer.App.Views.Pages.RestoreCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{loc:Loc Restore.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenEmergencyCommand}"
                        Content="{loc:Loc Restore.EmergencyOpen}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCommand}"
                        Content="{loc:Loc Common.Delete}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource AccentButton}" Command="{Binding RestoreCommand}"
                        Content="{loc:Loc Common.Restore}" MinWidth="120"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="{loc:Loc Restore.SnapshotList}" Style="{StaticResource SectionTitle}"/>

        <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                 Style="{StaticResource NeyraListBox}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource RowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding CreatedText}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="{Binding ChangesText}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="{Binding IntegrityText}" VerticalAlignment="Center"
                                       FontSize="11.5" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
