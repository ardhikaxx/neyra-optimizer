<UserControl x:Class="NeyraOptimizer.App.Views.Pages.OptimizationCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization"
             xmlns:vm="clr-namespace:NeyraOptimizer.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{loc:Loc OptCenter.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{loc:Loc OptCenter.OneClickNote}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource AccentButton}"
                    Command="{Binding OneClickSafeCommand}" Content="{loc:Loc OptCenter.OneClickSafe}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding ApplySelectedCommand}"
                        Content="{loc:Loc Common.Apply}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding SelectSafeRecommendedCommand}"
                        Content="{loc:Loc OptCenter.SelectSafeRecommended}" Margin="8,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ClearSelectionCommand}"
                        Content="{loc:Loc OptCenter.ClearSelection}"/>
                <TextBox x:Name="SearchBox" Width="260" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Style="{StaticResource NeyraTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{loc:Loc Common.Search}"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding GroupedVisibleItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Key}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextSecondary}" Margin="2,8,0,6"/>
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RecommendationRow}">
                                        <Border Style="{StaticResource CardBorder}" Padding="14,11" Margin="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top"
                                                          IsEnabled="{Binding CanModify, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                                <StackPanel Grid.Column="1" Margin="10,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                                               TextWrapping="Wrap" Margin="0,2"/>
                                                    <TextBlock Text="{Binding Reason}" FontSize="11.5" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2"/>
                                                    <TextBlock Text="{Binding RiskText}" FontSize="11.5"
                                                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" VerticalAlignment="Top">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Optional.Bg}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CategoryKey}" Value="Cat.Safe">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.Safe.Bg}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CategoryKey}" Value="Cat.Recommended">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.Recommended.Bg}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CategoryKey}" Value="Cat.Advanced">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.Advanced.Bg}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CategoryKey}" Value="Cat.DoNotModify">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.Protected.Bg}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding CategoryText}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
