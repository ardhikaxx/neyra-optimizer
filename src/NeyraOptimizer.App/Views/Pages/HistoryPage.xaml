<UserControl x:Class="NeyraOptimizer.App.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc History.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="16,11" Margin="0,4">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StartedText}" FontWeight="SemiBold"/>
                                        <Border Style="{StaticResource BadgeBorder}" Background="{DynamicResource Brush.Accent.Subtle}"
                                                Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Profile}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Accent}"/>
                                        </Border>
                                        <TextBlock Text="{Binding RestartText}" Margin="8,0,0,0" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,3"/>
                                <TextBlock Text="{loc:Loc History.Details}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,2"/>
                                <ItemsControl ItemsSource="{Binding Model.Details}" MaxHeight="150">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140" Margin="0,4,0,0">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}"
                                                       Margin="0,1">
                                                <Run Text="{Binding TimestampUtc, Mode=OneWay, StringFormat='{}{0:HH:mm:ss}'}"/>
                                                <Run Text="·"/><Run Text="{Binding Action, Mode=OneWay}"/>
                                                <Run Text="·"/><Run Text="{Binding Target, Mode=OneWay}"/>
                                                <Run Text="→"/><Run Text="{Binding Result, Mode=OneWay}"/>
                                                <Run Text="{Binding ErrorText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
