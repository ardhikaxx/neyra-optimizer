<UserControl x:Class="NeyraOptimizer.App.Views.Pages.AnalyzePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <TextBlock Text="{loc:Loc Analyze.Title}" Style="{StaticResource PageTitle}"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource AccentButton}"
                        Command="{Binding RunCommand}" Content="{loc:Loc Analyze.RunFull}"
                        IsEnabled="{Binding CanModify, Mode=OneWay}"/>
            </Grid>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10"><StackPanel>
                    <TextBlock Text="{loc:Loc Analyze.OS}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding OsText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="{loc:Loc Analyze.CPU}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding CpuText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10"><StackPanel>
                    <TextBlock Text="{loc:Loc Analyze.RAM}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding RamText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="{loc:Loc Analyze.GPU}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding GpuText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10"><StackPanel>
                    <TextBlock Text="{loc:Loc Analyze.Storage}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding StorageText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="{loc:Loc Analyze.Battery}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding BatteryText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10"><StackPanel>
                    <TextBlock Text="{loc:Loc Analyze.PowerPlan}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding PowerPlanText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="{loc:Loc Analyze.Security}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding SecurityText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10"><StackPanel>
                    <TextBlock Text="{loc:Loc Analyze.Elevation}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ElevationText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="{loc:Loc Dash.DeviceClass}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding DeviceClassText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
            </UniformGrid>

            <Border Style="{StaticResource CardBorder}" Visibility="{Binding ClassificationReasons, Converter={StaticResource EmptyToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Analyze.ClassificationReasons}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding ClassificationReasons}" FontSize="12" LineHeight="18"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
