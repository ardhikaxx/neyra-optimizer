<UserControl x:Class="NeyraOptimizer.App.Views.Pages.ScheduledTasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Tasks.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleCommand}"
                        Content="{loc:Loc Common.Disable}" MinWidth="100" Margin="8,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"
                        Content="{loc:Loc Common.Refresh}"/>
                <TextBox Width="280" VerticalAlignment="Center" Style="{StaticResource NeyraTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}"
                 Style="{StaticResource NeyraListBox}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource RowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LastRunText}" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextSecondary}"/>
                                <TextBlock Text="{Binding NextRunText}" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
