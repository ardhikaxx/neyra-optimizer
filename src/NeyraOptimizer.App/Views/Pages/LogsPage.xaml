<UserControl x:Class="NeyraOptimizer.App.Views.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Logs.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}"
                        Content="{loc:Loc Logs.OpenFolder}" MinWidth="140" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"
                        Content="{loc:Loc Common.Refresh}"/>
                <ComboBox Width="130" VerticalAlignment="Center" Style="{StaticResource NeyraComboBox}"
                          ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding MinSeverity}"/>
                <TextBox Width="260" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource NeyraTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding VisibleRows}" Background="{DynamicResource Brush.Card.Background}"
                 BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                 FontFamily="Consolas" FontSize="12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Brush.TextMuted}" Width="95"/>
                            <TextBlock Text="{Binding Level}" Width="70" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Critical">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="700"
                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
