<UserControl x:Class="NeyraOptimizer.App.Views.Pages.PrivacyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization"
             xmlns:vm="clr-namespace:NeyraOptimizer.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc Privacy.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{loc:Loc Privacy.Note}" Style="{StaticResource MutedText}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                   Foreground="{DynamicResource Brush.Warning}" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PrivacyRow}">
                        <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding RiskText}" FontSize="11.5"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                          Checked="Privacy_Changed" Unchecked="Privacy_Changed"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
