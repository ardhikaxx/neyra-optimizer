<UserControl x:Class="NeyraOptimizer.App.Views.Pages.ModePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding ModeName}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="760"
                           HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding ModeNote}" Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="760"
                           HorizontalAlignment="Left" FontWeight="SemiBold"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource AccentButton}"
                    Command="{Binding EnableCommand}" Content="{loc:Loc Modes.EnableMode}"
                    IsEnabled="{Binding CanModify, Mode=OneWay}"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Brush.Badge.Advanced.Bg}" CornerRadius="8" Padding="14,9"
                Margin="0,0,0,10" Visibility="{Binding IsAvailable, Converter={StaticResource InverseBool}}">
            <TextBlock Text="{Binding UnavailabilityReason}" TextWrapping="Wrap" FontSize="12.5"
                       Foreground="{DynamicResource Brush.Badge.Advanced.Fg}"/>
        </Border>

        <TextBlock Grid.Row="2" Text="{loc:Loc Modes.WhatWillChange}" Style="{StaticResource SectionTitle}"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,4">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Text="{Binding RiskText}" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
