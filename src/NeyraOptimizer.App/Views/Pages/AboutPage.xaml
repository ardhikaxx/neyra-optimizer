<UserControl x:Class="NeyraOptimizer.App.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource Brush.Accent}">
                    <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,4,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc App.Title}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc App.Subtitle}" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc About.WhatItIs}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13"/>
                    <TextBlock Text="{loc:Loc About.WhatItIsNot}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13"/>
                    <TextBlock Text="{loc:Loc About.PrivacyNote}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
