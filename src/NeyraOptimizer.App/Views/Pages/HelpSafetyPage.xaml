<UserControl x:Class="NeyraOptimizer.App.Views.Pages.HelpSafetyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{loc:Loc Help.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,14"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Help.HowRollbackWorks}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{loc:Loc Help.RollbackBody}" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Help.WhatWeNeverTouch}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{loc:Loc Help.NeverTouchBody}" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Help.SupportBundle}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{loc:Loc Help.BundleContents}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Command="{Binding CreateBundleCmd}" Content="{loc:Loc Help.SupportBundle}"
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" MinWidth="200"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
