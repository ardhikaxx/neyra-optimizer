<UserControl x:Class="NeyraOptimizer.App.Views.Pages.DebloatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Debloat.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Command="{Binding ApplySelectedCommand}"
                        Content="{loc:Loc Common.Apply}" MinWidth="130" Margin="8,0,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding SelectAllOptionalCommand}"
                        Content="{loc:Loc Debloat.SelectAllSafe}"/>
                <TextBox Width="260" VerticalAlignment="Center" Style="{StaticResource NeyraTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>

        <ListBox Grid.Row="3" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}"
                 Style="{StaticResource NeyraListBox}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource RowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                      IsEnabled="{Binding Protected, Converter={StaticResource InverseBool}}"/>
                            <StackPanel Grid.Column="1" Margin="6,0">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ReinstallNote}" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Publisher}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Grid.Column="4" Text="{Binding Version}" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Grid.Column="5" Text="{Binding KindText}" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
