<Window x:Class="NeyraOptimizer.App.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}">
    <Border Padding="24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock x:Name="IconText" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10"/>
            <Border x:Name="DetailBorder" Background="{DynamicResource Brush.Input.Background}"
                    BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                    CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
                <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="CancelBtn" Style="{StaticResource SecondaryButton}" MinWidth="96" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmBtn" Style="{StaticResource AccentButton}" MinWidth="110"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
