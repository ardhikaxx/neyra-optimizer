<Window x:Class="NeyraOptimizer.App.Views.Dialogs.PreviewChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization"
        Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}">
    <Border Padding="26">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <StackPanel x:Name="Lines"/>
            </Border>

            <TextBlock x:Name="AdminNote" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,4" Visibility="Collapsed" Text="{loc:Loc Preview.RequiresAdmin}"/>
            <TextBlock x:Name="RestartNote" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,4" Visibility="Collapsed" Text="{loc:Loc Preview.RestartNeeded}"/>
            <Border x:Name="UninstallWarning" Background="{DynamicResource Brush.Badge.Advanced.Bg}"
                    CornerRadius="8" Padding="12,9" Margin="0,8,0,8" Visibility="Collapsed">
                <TextBlock Text="{loc:Loc Preview.WarningUninstall}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource Brush.Badge.Advanced.Fg}"/>
            </Border>

            <StackPanel x:Name="WarningsPanel" Margin="0,4,0,4" Visibility="Collapsed">
                <TextBlock Text="{loc:Loc OptCenter.AdvancedWarning}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,4"/>
                <ItemsControl x:Name="WarningsList"/>
            </StackPanel>

            <CheckBox x:Name="RestorePointCheck" Content="{loc:Loc Preview.CreateRestorePoint}"
                      Margin="0,10,0,14"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Style="{StaticResource SecondaryButton}" MinWidth="96" Margin="0,0,8,0"/>
                <Button x:Name="ApplyBtn" Style="{StaticResource AccentButton}" MinWidth="120"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
