<Window x:Class="NeyraOptimizer.App.Views.Dialogs.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NeyraOptimizer.App.Localization"
        Title="{loc:Loc Recovery.Title}" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}">
    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="{loc:Loc Recovery.Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DismissBtn" Style="{StaticResource SecondaryButton}" MinWidth="140"
                        Content="{loc:Loc Recovery.DismissBtn}" Margin="0,0,8,0"/>
                <Button x:Name="RollbackBtn" Style="{StaticResource AccentButton}" MinWidth="150"
                        Content="{loc:Loc Recovery.RollbackBtn}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
