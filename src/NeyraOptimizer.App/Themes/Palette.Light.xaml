<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette: clean, professional utility. Accent = trust blue. -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Card.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Card.Border" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#EDF1F7"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#475569"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#94A3B8"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#1E40AF"/>
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#EFF4FF"/>

    <SolidColorBrush x:Key="Brush.Success" Color="#16A34A"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#D97706"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626"/>

    <SolidColorBrush x:Key="Brush.Badge.Safe.Bg" Color="#E8F7EE"/>
    <SolidColorBrush x:Key="Brush.Badge.Safe.Fg" Color="#15803D"/>
    <SolidColorBrush x:Key="Brush.Badge.Recommended.Bg" Color="#EFF4FF"/>
    <SolidColorBrush x:Key="Brush.Badge.Recommended.Fg" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Brush.Badge.Optional.Bg" Color="#FDF3E3"/>
    <SolidColorBrush x:Key="Brush.Badge.Optional.Fg" Color="#B45309"/>
    <SolidColorBrush x:Key="Brush.Badge.Advanced.Bg" Color="#FCE9E9"/>
    <SolidColorBrush x:Key="Brush.Badge.Advanced.Fg" Color="#B91C1C"/>
    <SolidColorBrush x:Key="Brush.Badge.Protected.Bg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.Badge.Protected.Fg" Color="#64748B"/>

    <SolidColorBrush x:Key="Brush.Input.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Input.Border" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Brush.ListItem.Hover" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.ListItem.Selected" Color="#E4EDFF"/>
    <SolidColorBrush x:Key="Brush.ProgressBar.Fill" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.ProgressBar.Track" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.Scrollbar" Color="#CBD5E1"/>
</ResourceDictionary>
